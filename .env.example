# Copia este archivo como ".env" y pon tus valores reales.
# El ".env" real NUNCA se sube a git (esta en .gitignore).

# Cadena de conexion de Neon (Connect -> Connection string).
# Para psycopg 3 debe empezar con postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://usuario:contrasena@host.neon.tech/neondb?sslmode=require

# Clave para firmar las sesiones. Genera una con:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto

ACCESS_TOKEN_EXPIRE_MINUTES=60

# URL del frontend (CORS). En local, Vite/SvelteKit usa 5173.
FRONTEND_URL=http://localhost:5173

# true en produccion (cookie solo por HTTPS y redireccion a https).
# false SOLO en tu computador, donde no hay HTTPS.
COOKIE_SECURE=false
FORZAR_HTTPS=false
