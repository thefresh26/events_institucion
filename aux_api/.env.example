# Copia como .env (nunca se sube a git).
PORT=4000

# MySQL (Aiven, TiDB Cloud, Railway, FreeSQLDatabase, local...)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=conexion_escolar_aux
# false = local | true = SSL verificado (TiDB Cloud) | insecure = SSL sin verificar CA (Aiven)
DB_SSL=false

# DEBE ser exactamente el SECRET_KEY de la API principal (FastAPI): asi esta API valida los mismos JWT.
SECRET_KEY=cambia-esto

# Origenes permitidos para CORS, separados por coma. EN PRODUCCION es obligatorio (si falta se acepta cualquier origen).
CORS_ORIGINS=http://localhost:5173
